# Copie para .env.local e preencha. Em produção, configure no painel da Vercel.

# Firebase Admin SDK (service account) — /api/leads e painel admin
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Bucket do Firebase Storage (arquivos e propostas das negociações), ex.: seu-projeto.firebasestorage.app
FIREBASE_STORAGE_BUCKET=

# Firebase "Web API Key" (Configurações do projeto → Geral). SOMENTE servidor — nunca NEXT_PUBLIC.
# Usada pelo login do painel (REST do Firebase Auth chamada pelo servidor).
FIREBASE_WEB_API_KEY=

# Cloudflare Turnstile (anti-bot do /contato e do login do painel)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Slug da rota oculta do painel admin (ex.: meu-painel → /meu-painel).
# Vazio = painel desativado. Não use um caminho que já exista no site.
ADMIN_PATH=

# Chave AES-256 (32 bytes em base64) que criptografa o estado temporário do login (etapa do 2FA).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ADMIN_PENDING_SECRET=

# (Opcional) Envio de e-mails para leads pelo CRM, via Resend (https://resend.com). SOMENTE servidor.
# O domínio do remetente precisa estar verificado no Resend (registros DNS).
# Sem estas duas, o compositor de e-mail abre mas avisa que o envio não está configurado.
RESEND_API_KEY=
CRM_EMAIL_FROM="Tecfy <contato@tecfy.dev>"

# (Opcional) Webhook do Discord ou Slack para alertas em tempo real do painel
# (login, bloqueio, novo 2FA, sessão usada em outro dispositivo). Deve começar com https://
ADMIN_ALERT_WEBHOOK_URL=

# (Opcional) Para onde vai o aviso de lead novo do site (padrão: contato@tecfy.dev).
# Usa o mesmo Resend acima (RESEND_API_KEY + CRM_EMAIL_FROM).
LEAD_NOTIFY_EMAIL=contato@tecfy.dev

# SÓ para testar o painel localmente com `npm start` (modo produção). Nunca defina na Vercel.
# ADMIN_ALLOW_LOCALHOST=1
